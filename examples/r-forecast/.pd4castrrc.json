{
  "name": "R Forecast",
  "summary": "Half-hourly NEM price forecast for the next day from an STL and ETS model in R, with 80% prediction intervals.",
  "forecastVariable": "price",
  "timeHorizon": "day_ahead",
  "displayTimezone": "Australia/Brisbane",
  "metadata": {
    "author": "Your Company Name",
    "version": "1.0.0"
  },
  "runMode": "AUTOMATIC",
  "outputFileFormat": "json",
  "inputs": [
    {
      "key": "dispatch_price",
      "storageLocation": "0bdfd52b-efaa-455e-9a3b-1a6d2b879b73",
      "fetcher": {
        "type": "AEMO_MMS",
        "checkInterval": 300,
        "config": {
          "checkQuery": "queries/data-fetchers/dispatch_price_check.sql",
          "fetchQuery": "queries/data-fetchers/dispatch_price_fetch.sql"
        }
      },
      "trigger": "WAIT_FOR_LATEST_FILE",
      "uploadFileFormat": "json",
      "targetFileFormat": "json"
    }
  ],
  "outputs": [
    {
      "name": "NSW1",
