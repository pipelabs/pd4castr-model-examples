{
  "name": "Python Demo",
  "summary": "Demonstration half-hourly NEM price forecast across the five regions.",
  "forecastVariable": "price",
  "timeHorizon": "day_ahead",
  "displayTimezone": "Australia/Brisbane",
  "metadata": {
    "author": "Your Company Name",
    "version": "1.0.0"
  },
  "runMode": "AUTOMATIC",
  "outputFileFormat": "json",
  "inputs": [
    {
      "key": "example_static_input",
      "file": "test_input/example_static_input.json",
      "source": "0bdfd52b-efaa-455e-9a3b-1a6d2b879b73",
      "trigger": "USE_MOST_RECENT_FILE",
      "uploadFileFormat": "json",
      "targetFileFormat": "json"
    },
    {
      "key": "dispatch_price",
      "source": "0bdfd52b-efaa-455e-9a3b-1a6d2b879b73",
      "fetcher": {
        "type": "AEMO_MMS",
        "checkInterval": 300,
        "config": {
          "checkQuery": "queries/data-fetchers/dispatch_price_check.sql",
          "fetchQuery": "queries/data-fetchers/dispatch_price_fetch.sql"
        }
      },
      "trigger": "WAIT_FOR_LATEST_FILE",
      "uploadFileFormat": "json",
      "targetFileFormat": "json"
    },
    {
      "key": "predispatch_price",
      "source": "0bdfd52b-efaa-455e-9a3b-1a6d2b879b73",
      "fetcher": {
        "type": "AEMO_MMS",
        "checkInterval": 300,
        "config": {
          "checkQuery": "queries/data-fetchers/predispatch_price_check.sql",
          "fetchQuery": "queries/data-fetchers/predispatch_price_fetch.sql"
        }
      },
      "trigger": "WAIT_FOR_LATEST_FILE",
      "uploadFileFormat": "json",
      "targetFileFormat": "json"
    },
    {
      "key": "predispatch_region_sum",
      "source": "0bdfd52b-efaa-455e-9a3b-1a6d2b879b73",
      "fetcher": {
        "type": "AEMO_MMS",
        "checkInterval": 300,
        "config": {
          "checkQuery": "queries/data-fetchers/predispatch_region_sum_check.sql",
          "fetchQuery": "queries/data-fetchers/predispatch_region_sum_fetch.sql"
        }
      },
      "trigger": "WAIT_FOR_LATEST_FILE",
      "uploadFileFormat": "json",
      "targetFileFormat": "json"
    }
  ],
  "outputs": [
    {
      "name": "NSW1",
      "key": "nsw1",
      "type": "float",
      "seriesKey": true,
      "colour": "#84EDDC"
    },
    {
      "name": "QLD1",
      "key": "qld1",
      "type": "float",
      "seriesKey": true,
      "colour": "#FD4E4E"
    },
    {
      "name": "SA1",
      "key": "sa1",
      "type": "float",
      "seriesKey": true,
      "colour": "#FED600"
    },
    {
      "name": "TAS1",
      "key": "tas1",
      "type": "float",
      "seriesKey": true,
      "colour": "#40A967"
    },
    {
      "name": "VIC1",
      "key": "vic1",
      "type": "float",
      "seriesKey": true,
      "colour": "#1965C6"
    }
  ],
  "// WARNING: DO NOT MODIFY THESE SYSTEM MANAGED VALUES": "",
  "$$id": null,
  "$$modelGroupID": null,
  "$$configVersion": 7,
  "$$revision": null,
  "$$dockerImage": null,
  "$schema": "https://raw.githubusercontent.com/pipelabs/pd4castr-model-examples/main/schemas/v1/model-config.json"
}
