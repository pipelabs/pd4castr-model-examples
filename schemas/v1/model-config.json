{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/pipelabs/pd4castr-model-examples/main/schemas/v1/model-config.json",
  "title": "pd4castr model configuration schema",
  "description": "Schema for .pd4castrrc.json configuration files",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "forecastVariable", "timeHorizon", "inputs", "outputs"],
  "properties": {
    "$$id": {
      "type": ["null", "string"],
      "default": null,
      "description": "DO NOT EDIT: Unique ID for the model."
    },
    "$$modelGroupID": {
      "type": ["null", "string"],
      "default": null,
      "description": "DO NOT EDIT: Unique ID of the group the model belongs to."
    },
    "$$revision": {
      "type": ["null", "integer"],
      "minimum": 0,
      "default": null,
      "description": "DO NOT EDIT: Revision of the model."
    },
    "$$dockerImage": {
      "type": ["null", "string"],
      "default": null,
      "description": "DO NOT EDIT: Docker image name. Initially null until published, then populated with the image name."
    },
    "$$configVersion": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "DO NOT EDIT: Configuration version number."
    },
    "name": {
      "type": "string",
      "description": "Name of the model."
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "default": "",
      "description": "Short description of the model shown in the model info dialog (max 500 characters)."
    },
    "description": {
      "type": "string",
      "description": "Inline long-form Markdown description shown on the model details page. Mutually exclusive with `descriptionFile`."
    },
    "descriptionFile": {
      "type": "string",
      "pattern": "\\.md$",
      "description": "Path to a Markdown file inlined as the description at publish time. Mutually exclusive with `description`."
    },
    "metadata": {
      "type": "object",
      "description": "Flexible object for storing model metadata. Can contain any properties.",
      "additionalProperties": true
    },
    "forecastVariable": {
      "type": "string",
      "enum": ["price"],
      "description": "The type of forecast variable in the model output."
    },
    "timeHorizon": {
      "type": "string",
      "enum": ["day_ahead", "week_ahead", "quarterly", "annual", "historical"],
      "description": "The time horizon of the forecast."
    },
    "displayTimezone": {
      "type": "string",
      "default": "Australia/Brisbane",
      "description": "IANA time zone used for displaying model data."
    },
    "defaultComparisonModels": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "IDs of the models shown for comparison on this model's chart by default."
    },
    "public": {
      "type": "boolean",
      "default": false,
      "description": "Whether the model is publicly accessible."
    },
    "runMode": {
      "type": "string",
      "enum": ["AUTOMATIC", "ON_DEMAND"],
      "description": "How runs are triggered. AUTOMATIC runs when new input data arrives; ON_DEMAND runs only when explicitly triggered.",
      "default": "AUTOMATIC"
    },
    "runDatetimeQuery": {
      "type": ["null", "string"],
      "default": null,
      "description": "Path to SQL query for determining the model run datetime."
    },
    "outputFileFormat": {
      "type": "string",
      "enum": ["json", "csv", "parquet"],
      "default": "json",
      "description": "Format of the model output file."
    },
    "inputs": {
      "type": "array",
      "description": "Array of model inputs. Inputs with a `fetcher` pull data from AEMO MMS; inputs without one are static and upload a local `file`.",
      "items": {
        "type": "object",
        "required": ["key", "trigger"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this input. Exposed to the model as the INPUT_<KEY>_URL environment variable."
          },
          "file": {
            "type": "string",
            "description": "Static inputs only: path to the local file uploaded at publish, relative to the project root."
          },
          "source": {
            "type": "string",
            "description": "ID of the input source. Defaults to the platform's shared source."
          },
          "inputSource": {
            "type": "string",
            "description": "Deprecated: renamed to `source`. The CLI still accepts it and rewrites it on the next publish."
          },
          "trigger": {
            "type": "string",
            "enum": ["WAIT_FOR_LATEST_FILE", "USE_MOST_RECENT_FILE"],
            "description": "Condition that determines when this input is ready to be used to trigger a model run."
          },
          "uploadFileFormat": {
            "type": "string",
            "enum": ["json", "csv", "parquet"],
            "default": "json",
            "description": "Format of the input file that will be uploaded to the input source."
          },
          "targetFileFormat": {
            "type": "string",
            "enum": ["json", "csv", "parquet"],
            "default": "json",
            "description": "Format of the input file that will be used in the model. Uploaded files will be converted to this format."
          },
          "axes": {
            "type": "object",
            "description": "Static inputs only: map of axis key to how this input participates in that axis.",
            "additionalProperties": {
              "type": "object",
              "required": ["kind", "column"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["partition"],
                  "description": "How the file participates in the axis. `partition` splits the file by the values in `column`."
                },
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Column in the file that holds the axis value."
                }
              }
            }
          },
          "fetcher": {
            "type": "object",
            "required": ["type", "checkInterval", "config"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["AEMO_MMS"],
                "description": "Type of data fetcher."
              },
              "checkInterval": {
                "type": "integer",
                "minimum": 60,
                "description": "Interval in seconds to check for new data."
              },
              "config": {
                "type": "object",
                "required": ["checkQuery", "fetchQuery"],
                "additionalProperties": false,
                "properties": {
                  "checkQuery": {
                    "type": "string",
                    "description": "Path to SQL query for checking if we need to fetch new data."
                  },
                  "fetchQuery": {
                    "type": "string",
                    "description": "Path to SQL query for fetching data."
                  }
                }
              }
            }
          }
        },
        "if": {
          "not": {
            "required": ["fetcher"]
          }
        },
        "then": {
          "required": ["file"]
        },
        "else": {
          "not": {
            "required": ["file"]
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "default": [],
      "description": "Array of datasets made available to model run views.",
      "items": {
        "type": "object",
        "required": ["key", "file"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this dataset."
          },
          "file": {
            "type": "string",
            "description": "Path to the local dataset file, relative to the project root."
          },
          "fileFormat": {
            "type": "string",
            "enum": ["json", "csv", "parquet"],
            "description": "Format of the dataset file. Inferred from the file extension when omitted."
          },
          "source": {
            "type": "string",
            "description": "ID of the dataset source. Defaults to the platform's shared source."
          },
          "axes": {
            "type": "object",
            "description": "Map of axis key to how this file participates in that axis.",
            "additionalProperties": {
              "type": "object",
              "required": ["kind", "column"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["partition"],
                  "description": "How the file participates in the axis. `partition` splits the file by the values in `column`."
                },
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Column in the file that holds the axis value."
                }
              }
            }
          }
        }
      }
    },
    "inputAggregations": {
      "type": "array",
      "default": [],
      "description": "Array of input aggregation definitions.",
      "items": {
        "type": "object",
        "required": ["name", "key", "query"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the input aggregation."
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this input aggregation."
          },
          "query": {
            "type": "string",
            "description": "Path to SQL query for the aggregation."
          },
          "description": {
            "type": "string",
            "default": "",
            "description": "Description of the input aggregation."
          },
          "colours": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Array of colour values for the aggregation."
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "description": "Array of model output variables.",
      "items": {
        "type": "object",
        "required": ["name", "key", "type", "seriesKey"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the output variable."
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this output. Lowercase alphanumeric with hyphens and underscores."
          },
          "type": {
            "type": "string",
            "enum": [
              "float",
              "integer",
              "string",
              "date",
              "boolean",
              "unknown"
            ],
            "description": "Type of the output variable."
          },
          "seriesKey": {
            "type": "boolean",
            "description": "Whether this output is a series key."
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Hex color code that will be used to display this output."
          }
        }
      }
    },
    "sensitivities": {
      "type": "array",
      "default": [],
      "description": "Array of sensitivity analysis definitions.",
      "items": {
        "type": "object",
        "required": ["name", "key", "query"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the sensitivity."
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this sensitivity. Lowercase alphanumeric with hyphens and underscores."
          },
          "query": {
            "type": "string",
            "description": "Path to SQL query for the sensitivity."
          }
        }
      }
    },
    "views": {
      "type": "array",
      "default": [],
      "description": "Array of parameterised SQL views shown on the model run page.",
      "items": {
        "type": "object",
        "required": ["key", "name", "sql", "columns"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this view."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the view."
          },
          "sql": {
            "type": "string",
            "description": "Path to the view's SQL file, relative to the project root."
          },
          "params": {
            "type": "object",
            "default": {},
            "description": "Map of parameter name to parameter definition.",
            "additionalProperties": {
              "type": "object",
              "required": ["type", "label"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "number", "boolean"],
                  "description": "Type of the parameter value."
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Label shown beside the parameter field."
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Tooltip text shown beside the parameter label."
                },
                "optional": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether the parameter can be left empty."
                },
                "control": {
                  "type": "string",
                  "enum": ["select"],
                  "description": "Input control used for the parameter."
                },
                "options": {
                  "type": "string",
                  "description": "Path to a SQL file whose rows populate the dropdown. Required when `control` is `select`, invalid otherwise."
                },
                "defaultFrom": {
                  "type": "string",
                  "description": "Where the default value comes from: `<srcParamName>.metadata.<key>` (requires `optional: true`) or `run.axis.<key>`."
                },
                "sample": {
                  "type": ["string", "number", "boolean"],
                  "description": "Sample value used to validate the view at publish. Must match `type`."
                }
              },
              "if": {
                "required": ["control"]
              },
              "then": {
                "required": ["options"]
              },
              "else": {
                "not": {
                  "required": ["options"]
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "description": "Columns returned by the view.",
            "items": {
              "type": "object",
              "required": ["key", "role"],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Column name returned by the SQL."
                },
                "role": {
                  "type": "string",
                  "enum": ["dimension", "measure"],
                  "description": "Whether the column is a dimension or a measure."
                },
                "label": {
                  "type": "string",
                  "description": "Display label for the column."
                },
                "unit": {
                  "type": "string",
                  "description": "Unit shown with the column's values."
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "currency",
                    "percent",
                    "integer",
                    "decimal",
                    "date",
                    "datetime"
                  ],
                  "description": "Display format for the column's values."
                }
              }
            }
          }
        }
      }
    },
    "axes": {
      "type": "array",
      "default": [],
      "description": "Array of model axes. Each axis value produces its own run variant.",
      "items": {
        "type": "object",
        "required": ["key", "type", "valuesFrom", "default"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Unique key for referencing this axis."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Display label for the axis."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Description of the axis."
          },
          "type": {
            "type": "string",
            "enum": ["number", "string", "boolean"],
            "description": "Type of the axis values."
          },
          "valuesFrom": {
            "type": "object",
            "required": ["kind", "values"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["static"],
                "description": "Where the axis values come from."
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": ["number", "string", "boolean"]
                },
                "description": "The axis values."
              }
            }
          },
          "default": {
            "type": ["number", "string", "boolean"],
            "description": "Default axis value. Cannot change once the model is published."
          }
        }
      }
    }
  },
  "not": {
    "required": ["description", "descriptionFile"]
  }
}
